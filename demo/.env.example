# Copy to .env and fill in. Never commit .env.
# ---- LLM (extraction refine / conflict judgement) ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Embeddings (optional; DeepSeek has no embeddings endpoint) ----
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3

# ---- Web board token (auto-generated on first start if absent) ----
API_TOKEN=
